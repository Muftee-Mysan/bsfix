---
import { u } from '../config';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og/default.png' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — food waste into compost and feed, Colombo` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(u(ogImage), Astro.site ?? site.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BSFix',
  url: site.url,
  email: site.email,
  logo: new URL(u('/favicon.svg'), site.url).href,
  description:
    'Youth-led climate project from Sri Lanka using Black Soldier Fly larvae to turn food waste into compost and protein-rich larvae, on site.',
  areaServed: 'Colombo, Western Province, Sri Lanka',
  ...(site.instagramHandle ? { sameAs: [`https://www.instagram.com/${site.instagramHandle}/`] } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta name="theme-color" content="#1F6B4A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BSFix" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {site.plausibleDomain && (
      <script defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js" />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
