---
import { u } from '../../config';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Updates" description="News from the BSFix project: building units, pilot results and public sites in Colombo.">
  <section class="section">
    <div class="wrap">
      <h1>Updates</h1>
      <p class="lede">News from the project as it happens. We also post on Instagram from December 2026.</p>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <p class="posts__date"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>{p.data.todo && <> <span class="todo">TODO: placeholder date</span></>}</p>
            <h2><a href={u(`/updates/${p.id}/`)}>{p.data.title}</a></h2>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .posts { list-style: none; padding: 0; max-width: 48rem; }
  .posts li { border-top: 1px solid var(--line); padding-block: 1.5rem; }
  .posts h2 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .posts h2 a { color: var(--soil); }
  .posts__date { color: var(--compost); font-size: 0.9375rem; margin-bottom: 0.3rem; }
</style>
