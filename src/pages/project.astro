---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Progress from '../components/Progress.astro';
import Recognition from '../components/Recognition.astro';
import Y4CBlock from '../components/Y4CBlock.astro';
import teamPhoto from '../assets/photos/team-site-visit.jpeg';
import monitorPhoto from '../assets/photos/larvae-monitoring-system.jpeg';
import cagePhoto from '../assets/photos/mesh-cage-on-beds.jpeg';
import { team } from '../data/team';
---

<Base
  title="The project"
  description="BSFix project overview: theory of change, phases from December 2026 to December 2028, targets, team and recognition. Supported by Youth4Climate."
>
  <section class="section">
    <div class="wrap">
      <h1>The project</h1>
      <p class="lede">
        BSFix is a youth-led climate project from Sri Lanka, supported by the Youth4Climate Financial Award 2025. It runs from December 2026 to December 2028 in Colombo and the surrounding Western Province.
      </p>
      <p class="toc">
        If communities use Black Soldier Flies and other nature-inspired solutions for waste, more waste is disposed of sustainably, because there is an effective alternative.
      </p>
      <p>
        After the project, we plan to become a startup that runs an on-site food-waste service for hotels, canteens and institutions, and supplies larvae to farmers.
      </p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="timeline">
    <div class="wrap">
      <h2 id="timeline">Timeline</h2>
      <Timeline />
    </div>
  </section>

  <section class="section" aria-labelledby="targets">
    <div class="wrap">
      <h2 id="targets">Targets</h2>
      <p>Alongside the numbers below, we will run a market survey of 50+ respondents to shape the business plan.</p>
      <Progress />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="team">
    <div class="wrap">
      <h2 id="team">Team</h2>
      <p>Five final-year undergraduates, who compete together as Team Zypher.</p>
      <ul class="team">
        {team.map((p) => (
          <li>
            <Picture
              src={p.photo}
              alt={`Portrait of ${p.name}`}
              formats={['avif', 'webp']}
              widths={[200, 400]}
              sizes="(min-width: 60rem) 11rem, 45vw"
              loading="lazy"
              class="team__photo"
              style={`object-position: ${p.focus}`}
            />
            <strong>{p.name}</strong>
            {p.role ? <span class="muted">{p.role}</span> : <span class="todo">TODO: role</span>}
            {p.todo && <span class="todo">{p.todo}</span>}
          </li>
        ))}
      </ul>
      <figure class="team-fig">
        <Picture
          src={teamPhoto}
          alt="Five members of the BSFix team and collaborators standing on the frames of open composting beds under a shed roof, two of them holding compost in their hands."
          formats={['avif', 'webp']}
          widths={[480, 800, 960]}
          sizes="(min-width: 60rem) 48rem, 100vw"
          loading="lazy"
        />
        <figcaption><span class="todo">TODO: caption — who is pictured and where</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="built">
    <div class="wrap">
      <h2 id="built">What we have built so far</h2>
      <p>Before the Youth4Climate project starts, we have been testing ideas on small prototypes and learning from an existing Black Soldier Fly composting site.</p>
      <div class="built">
        <figure>
          <Picture
            src={monitorPhoto}
            alt="A prototype with a touchscreen reading 'Larvae Monitoring System – Start Larvae Monitoring', mounted above a tray holding a tub of larvae and compost."
            formats={['avif', 'webp']}
            widths={[400, 700]}
            sizes="(min-width: 48rem) 24rem, 100vw"
            loading="lazy"
          />
          <figcaption>Our larvae monitoring system prototype: a touchscreen unit that watches a tray of feeding larvae.</figcaption>
        </figure>
        <figure>
          <Picture
            src={cagePhoto}
            alt="A wooden-framed cage with green mesh sides on wheels, standing on open composting beds under a shed roof, with coconut palms outside."
            formats={['avif', 'webp']}
            widths={[400, 700]}
            sizes="(min-width: 48rem) 24rem, 100vw"
            loading="lazy"
          />
          <figcaption>A mesh-sided prototype on wheels, tried out on the composting beds during a site visit. <span class="todo">TODO: confirm caption</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="recog">
    <div class="wrap">
      <h2 id="recog">Recognition</h2>
      <Recognition />
    </div>
  </section>

  <section class="section section--leaf" aria-labelledby="y4c">
    <div class="wrap">
      <h2 id="y4c">Supported by Youth4Climate</h2>
      <Y4CBlock />
    </div>
  </section>
</Base>

<style>
  .toc { font-family: var(--font-head); font-size: var(--step-2); line-height: 1.25; font-weight: 600; max-width: 30ch; border-left: 5px solid var(--leaf); padding-left: 1.1rem; margin-block: 2rem; color: var(--green-dark); }
  .team { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.25rem; max-width: none; }
  @media (min-width: 40rem) { .team { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 60rem) { .team { grid-template-columns: repeat(5, 1fr); } }
  .team li { display: flex; flex-direction: column; gap: 0.2rem; align-items: flex-start; }
  .team :global(.team__photo) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.6rem; background: var(--leaf-soft); }
  .built { display: grid; gap: 2rem; margin-top: 1.5rem; }
  @media (min-width: 48rem) { .built { grid-template-columns: 1fr 1fr; } }
  .built figure { margin: 0; }
  .built :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  .built figcaption { margin-top: 0.6rem; font-size: 0.975rem; }
  .team-fig { margin: 2rem 0 0; max-width: 48rem; }
  .team-fig :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  .team-fig figcaption { margin-top: 0.6rem; }
</style>
