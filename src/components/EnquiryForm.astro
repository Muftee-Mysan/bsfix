---
// Enquiry form with no backend. Posts to site.formEndpoint (Formspree / Netlify Forms) when set;
// otherwise falls back to opening the visitor's email app with the answers filled in.
import { site } from '../config';

interface Props {
  kind: 'host' | 'farmer' | 'general';
  submitLabel?: string;
  sentLabel?: string;
}
const { kind, submitLabel = 'Send enquiry', sentLabel = 'Enquiry sent' } = Astro.props;
const id = `form-${kind}`;
const subject = { host: 'Hosting a BSFix unit', farmer: 'Larvae for my farm', general: 'Enquiry' }[kind];
const action = site.formEndpoint || `mailto:${site.email}?subject=${encodeURIComponent(`BSFix website: ${subject}`)}`;
---

<form
  class="form"
  id={id}
  action={action}
  method="post"
  enctype={site.formEndpoint ? undefined : 'text/plain'}
  data-enquiry
  data-endpoint={site.formEndpoint}
  data-email={site.email}
  data-subject={`BSFix website: ${subject}`}
  data-sent={sentLabel}
>
  <input type="hidden" name="form" value={kind} />
  <input type="hidden" name="_subject" value={`BSFix website: ${subject}`} />

  {kind === 'host' && (
    <>
      <div class="field">
        <label for={`${id}-org`}>Organisation name <span class="req" aria-hidden="true">*</span></label>
        <input id={`${id}-org`} name="organisation" required autocomplete="organization" />
      </div>
      <div class="field">
        <label for={`${id}-type`}>Type of organisation <span class="req" aria-hidden="true">*</span></label>
        <select id={`${id}-type`} name="type" required>
          <option value="">Choose one</option>
          <option>Hotel</option>
          <option>Canteen</option>
          <option>Market</option>
          <option>University</option>
          <option>Institution</option>
          <option>Farm</option>
          <option>Other</option>
        </select>
      </div>
      <div class="field">
        <label for={`${id}-loc`}>Location <span class="req" aria-hidden="true">*</span></label>
        <input id={`${id}-loc`} name="location" required placeholder="e.g. Colombo 07" />
      </div>
      <div class="field">
        <label for={`${id}-waste`}>Approximate food waste per day</label>
        <select id={`${id}-waste`} name="waste_per_day">
          <option value="">Not sure</option>
          <option>Under 10 kg</option>
          <option>10 – 25 kg</option>
          <option>25 – 50 kg</option>
          <option>50 – 100 kg</option>
          <option>Over 100 kg</option>
        </select>
      </div>
    </>
  )}

  {kind === 'farmer' && (
    <>
      <div class="field">
        <label for={`${id}-farm`}>Farm name or area <span class="req" aria-hidden="true">*</span></label>
        <input id={`${id}-farm`} name="farm" required />
      </div>
      <div class="field">
        <label for={`${id}-animals`}>What do you raise?</label>
        <select id={`${id}-animals`} name="animals">
          <option value="">Choose one</option>
          <option>Chickens</option>
          <option>Fish</option>
          <option>Both</option>
          <option>Other</option>
        </select>
      </div>
    </>
  )}

  <div class="field">
    <label for={`${id}-name`}>Your name <span class="req" aria-hidden="true">*</span></label>
    <input id={`${id}-name`} name="name" required autocomplete="name" />
  </div>
  <div class="field">
    <label for={`${id}-phone`}>Phone or WhatsApp</label>
    <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
  </div>
  <div class="field">
    <label for={`${id}-email`}>Email <span class="req" aria-hidden="true">*</span></label>
    <input id={`${id}-email`} name="email" type="email" required autocomplete="email" />
  </div>
  <div class="field">
    <label for={`${id}-msg`}>Message</label>
    <textarea id={`${id}-msg`} name="message"></textarea>
  </div>
  <p class="small muted">Fields marked <span class="req">*</span> are required. We only use your details to reply to you.</p>

  <div>
    <button class="btn btn--primary" type="submit">{submitLabel}</button>
  </div>
  <p class="form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const original = button.textContent;
    const { endpoint, email, subject, sent } = form.dataset;

    const say = (text: string, ok: boolean) => {
      status.hidden = false;
      status.className = `form-status ${ok ? 'form-status--ok' : 'form-status--error'}`;
      status.textContent = text;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);

      if (!endpoint) {
        const lines = Array.from(data.entries())
          .filter(([k, v]) => !k.startsWith('_') && k !== 'form' && String(v).trim())
          .map(([k, v]) => `${k.replace(/_/g, ' ')}: ${v}`);
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject!)}&body=${encodeURIComponent(lines.join('\n'))}`;
        say(`Your email app should open with your enquiry filled in. Press send there. If nothing opens, email us at ${email}.`, true);
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        button.textContent = sent!;
        say('Thank you. We have your enquiry and will get back to you.', true);
      } catch {
        button.disabled = false;
        button.textContent = original;
        say(`Sorry, your enquiry did not send. Please try again, or email us at ${email}.`, false);
      }
    });
  });
</script>
