---
import { u } from '../config';
import Logo from './Logo.astro';

const links = [
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/farmers/', label: 'For farmers' },
  { href: '/project/', label: 'Project' },
  { href: '/updates/', label: 'Updates' },
  { href: '/get-involved/', label: 'Get involved' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(u(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={u('/')} class="site-header__home" aria-label="BSFix home"><Logo /></a>

    <nav aria-label="Main" class="nav-desktop">
      <ul>
        {links.map((l) => (
          <li><a href={u(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary" href={u('/host-a-unit/')}>Host a unit</a>
    </nav>

    <details class="nav-mobile">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          <li><a href={u('/host-a-unit/')} class="strong">Host a BSFix unit</a></li>
          {links.map((l) => (
            <li><a href={u(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--rain); border-bottom: 1px solid var(--line); position: relative; z-index: 10; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.25rem; gap: 1rem; }
  .site-header__home { text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; }

  .nav-desktop { display: none; }
  @media (min-width: 62rem) {
    .nav-desktop { display: flex; align-items: center; gap: 1.5rem; }
    .nav-desktop ul { display: flex; gap: 1.25rem; }
    .nav-desktop ul a { color: var(--soil); text-decoration: none; font-weight: 700; font-size: 0.975rem; padding-block: 0.4rem; }
    .nav-desktop ul a:hover, .nav-desktop ul a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--teal); text-decoration-thickness: 2px; }
    .nav-desktop .btn { min-height: 42px; padding: 0.5rem 1rem; }
    .nav-mobile { display: none; }
  }

  .nav-mobile summary {
    list-style: none; cursor: pointer; font-weight: 700; min-height: 44px; min-width: 44px;
    display: flex; align-items: center; padding: 0.4rem 0.9rem;
    border: 2px solid var(--soil); border-radius: var(--radius);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile[open] summary { background: var(--soil); color: var(--rain); }
  .nav-mobile nav {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--rain); border-bottom: 1px solid var(--line);
    padding: 0.5rem var(--gutter) 1rem;
  }
  .nav-mobile li a {
    display: block; padding: 0.75rem 0; border-bottom: 1px solid var(--line);
    color: var(--soil); text-decoration: none; font-weight: 700; font-size: 1.1rem;
  }
  .nav-mobile li a.strong { color: var(--green-dark); }
  .nav-mobile li a[aria-current='page'] { color: var(--teal-dark); }
</style>
